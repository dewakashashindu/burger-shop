# MicroEChef — restaurant database
# The site reads the menu and writes ONE table: dbo.Tbl_holdUpsCloudTempOO
# (online orders). Everything else is read-only.
# Copy to .env.local (or .env) and fill in the real values, then restart the server.
DB_SERVER=
DB_PORT=
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Optional — only if the order table is called something else than
# dbo.Tbl_holdUpsCloudTempOO
WEB_ORDER_TABLE=

# Optional: rename the short top tabs (F / B / O) without touching code.
# MENU_CATEGORY_LABELS=F:Food,B:Beverage,O:Other

# Optional timeouts (milliseconds)
# DB_CONNECT_TIMEOUT=8000
# DB_REQUEST_TIMEOUT=12000

# ---------------------------------------------------------------- sign-in
# Codes are texted through Text.lk. Create the token in the Text.lk dashboard
# and keep it here, server-side only — it is never sent to the browser.
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=

# Optional: Text.lk endpoint, if the account uses a different one.
# TEXTLK_API_URL=https://app.text.lk/api/v3/sms/send

# Signs the session cookie. Set any long random string in production.
# Without it the cookie is signed with a value derived from the DB settings.
AUTH_SECRET=
# 1 = only send the cookie over https
# AUTH_COOKIE_SECURE=1

# The guests' book and the codes table.
# CUSTOMER_TABLE=dbo.Tbl_CustomerMaster
OTP_TABLE=dbo.Tbl_WebOtp
# A code lives five minutes; a second text is allowed after 60 seconds.
# OTP_TTL_SECONDS=300
# OTP_RESEND_SECONDS=60
# OTP_MAX_ATTEMPTS=5

# The web location — LoCCode 01 in Tbl_CustomerMaster and in Tbl_TxnNumbers.
WEB_LOC_CODE=01

# The customer number comes from the POS counter in dbo.Tbl_TxnNumbers:
#   LoCCode 01 · TxnType CC · Prefix A · TxnNo 3   ->   A000004, A000005, …
# TxnNos are taken inside the same transaction as the INSERT (UPDLOCK, HOLDLOCK),
# so two sign-ups at once never share a code. Only change these if the POS
# keeps its "Create Customer" row under another name.
# CUSTOMER_SEQ_TABLE=dbo.Tbl_TxnNumbers
# CUSTOMER_SEQ_TYPE=CC
# CUSTOMER_SEQ_PADDING=6
# Optional: a fixed code instead of the counter (leave empty in production).
WEB_CUS_CODE=

# 1 = keep accounts and codes in memory when no database is configured.
# Never turn this on in production.
WEB_AUTH_DEV=
